# Vercel AI Gateway. Copy to .env.local (gitignored). Localhost only, never deployed.
AI_GATEWAY_API_KEY=

# TypeSafe AI (lib/decide/providers.ts jevAdapter). Read implicitly by `experimental_evaluate`.
TYPESAFE_AI_API_KEY=

# Hard ceiling in USD across a single bench run. The runner refuses to start above it.
BUDGET_USD_HARD_CAP=1.00

# Local Ollama server.
OLLAMA_HOST=http://localhost:11434

# Bring-your-own-key providers (lib/decide/providers.ts). Set one here to skip pasting it into the
# UI on this machine. Never set these before deploying: the UI key field is the only input a
# hosted copy of this app should accept.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
VERCEL_API_KEY=
